 application "MentorConnect Faculty Consultation System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form appointment
		{
			displayname = "Appointment"
			success message = "Appointment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment_id
			(
    			type = autonumber
				displayname = "Appointment ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have consultation_request
			(
				type = list	
				displayname = "Consultation Request"
				values  = consultation_request.ID
    			displayformat = [request_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student
			(
				type = list	
				displayname = "Student"
				values  = student_registration.ID
    			displayformat = [student_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have faculty
			(
				type = list	
				displayname = "Faculty"
				values  = faculty_master.ID
    			displayformat = [faculty_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have appointment_date
			(
    			type = date
				displayname = "Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have start_time
			(
    			type = time
				displayname = "Start Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have end_time
			(
    			type = time
				displayname = "End Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have mode
			(
				type = picklist
				displayname = "Mode"
				values = {"Hybrid","Offline","Online"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			location_meeting_link
			(
    			type = url
				displayname = "Location / Meeting Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Scheduled","Reminder Sent","No Show","Completed","Cancelled","Rescheduled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			confirmation_sent
			(
    			type = checkbox
				displayname = "Confirmation Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Draft","Appointment Scheduled","Appointment Cancelled","Appointment Pending Confirmation","Appointment Confirmed","Appointment Rescheduled","Appointment In Progress","Appointment Completed","Appointment On Hold","Appointment Closed","Appointment Follow-up Required"}
			}
		}
		form consultation_record_feedback
		{
			displayname = "Consultation Record Feedback"
			success message = "Consultation Record Feedback Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have appointment
			(
				type = list	
				displayname = "Appointment"
				values  = appointment.ID
    			displayformat = [appointment_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student
			(
				type = list	
				displayname = "Student"
				values  = student_registration.ID
    			displayformat = [student_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have faculty
			(
				type = list	
				displayname = "Faculty"
				values  = faculty_master.ID
    			displayformat = [faculty_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have consultation_date
			(
    			type = date
				displayname = "Consultation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			discussion_summary
			(
    			type = textarea
				displayname = "Discussion Summary"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			advice_action_items
			(
    			type = textarea
				displayname = "Advice / Action Items"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have outcome_status
			(
				type = picklist
				displayname = "Outcome Status"
				values = {"Unresolved","Partial","Resolved"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			follow_up_required
			(
    			type = checkbox
				displayname = "Follow-up Required"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			follow_up_date
			(
    			type = date
				displayname = "Follow-up Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student_rating
			(
				type = number
				displayname = "Student Rating"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student_feedback
			(
    			type = textarea
				displayname = "Student Feedback"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have closure_status
			(
				type = radiobuttons
				displayname = "Closure Status"
				values = {"Closed","Open"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sentiment
			(
				type = picklist
				displayname = "Sentiment Analysis"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = SentimentAnalysis
									basefield = student_feedback
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
