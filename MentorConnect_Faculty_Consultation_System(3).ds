	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Student"
			{
				name = "Student"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Submit consultation requests regarding academic or career concerns \n"
				ModulePermissions
				{
					appointment
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							appointment_by_status={"View","Edit"}
							appointment_Report={"View","Edit"}
						}
					}
					consultation_request
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
					}
				}
			}
			"Parent"
			{
				name = "Parent"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "View student consultation history and appointment schedules \n"
				ModulePermissions
				{
					appointment
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							appointment_by_status={"View"}
							appointment_Report={"View"}
						}
					}
					consultation_record_feedback
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							consultation_record_feedback_Report={"View"}
							consultation_record_feedbac_by_outcome_status={"View"}
						}
					}
				}
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

