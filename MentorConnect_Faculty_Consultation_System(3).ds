		 functions
		 {
			 Deluge
			 {
				 void confirm_appointment(int appointmentId)
                 {
                 	appt = appointment[ID == appointmentId];
                 	if(appt.count() == 0)
                 	{
                 		return;
                 	}
                 	if(appt.consultation_request == null)
                 	{
                 		return;
                 	}
                 	requestRec = consultation_request[ID == appt.consultation_request.ID];
                 	if(requestRec.count() == 0)
                 	{
                 		return;
                 	}
                 	studentRec = student_registration[ID == requestRec.student.ID];
                 	facultyRec = faculty_master[ID == requestRec.faculty.ID];
                 	requestRec.status="Confirmed";
                 	appt.status="Scheduled";
                 	appt.confirmation_sent=true;
                 	dateText = appt.appointment_date.toString("dd-MMM-yyyy");
                 	startText = appt.start_time.toString("HH:mm");
                 	endText = appt.end_time.toString("HH:mm");
                 	modeText = ifNull(appt.mode,"Not specified");
                 	locationText = ifNull(appt.location_meeting_link,"Not specified");
                 	if(studentRec.count() > 0 && studentRec.email != null)
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :studentRec.email
                 			subject :"MentorConnect - Consultation Confirmed"
                 			message :"Hello " + studentRec.student_name.first_name + ",<br><br>" + "Your faculty consultation has been confirmed.<br><br>" + "<b>Date:</b> " + dateText + "<br>" + "<b>Time:</b> " + startText + " - " + endText + "<br>" + "<b>Mode:</b> " + modeText + "<br>" + "<b>Location / Meeting Link:</b> " + locationText + "<br><br>MentorConnect"
                 		]
                 	}
                 	if(facultyRec.count() > 0 && facultyRec.email != null)
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :facultyRec.email
                 			subject :"MentorConnect - Consultation Confirmed"
                 			message :"A consultation appointment has been confirmed.<br><br>" + "<b>Date:</b> " + dateText + "<br>" + "<b>Time:</b> " + startText + " - " + endText + "<br>" + "<b>Mode:</b> " + modeText + "<br>" + "<b>Location / Meeting Link:</b> " + locationText + "<br><br>MentorConnect"
                 		]
                 	}
                 }
				 map get_faculty_slot(int facultyId, date reqDate, time reqTime)
                 {
                 	result = Map();
                 	result.put("available",false);
                 	result.put("message","");
                 	result.put("mode","");
                 	result.put("location","");
                 	result.put("max_appointments",0);
                 	result.put("slot_start",null);
                 	result.put("slot_end",null);
                 	if(facultyId == null)
                 	{
                 		result.put("message","Faculty is required.");
                 		return result;
                 	}
                 	if(reqDate == null)
                 	{
                 		result.put("message","Request date is required.");
                 		return result;
                 	}
                 	if(reqTime == null)
                 	{
                 		result.put("message","Request time is required.");
                 		return result;
                 	}
                 	dayNumber = reqDate.getDayOfWeek();
                 	dayName = "";
                 	if(dayNumber == 1)
                 	{
                 		dayName = "Sunday";
                 	}
                 	else if(dayNumber == 2)
                 	{
                 		dayName = "Monday";
                 	}
                 	else if(dayNumber == 3)
                 	{
                 		dayName = "Tuesday";
                 	}
                 	else if(dayNumber == 4)
                 	{
                 		dayName = "Wednesday";
                 	}
                 	else if(dayNumber == 5)
                 	{
                 		dayName = "Thursday";
                 	}
                 	else if(dayNumber == 6)
                 	{
                 		dayName = "Friday";
                 	}
                 	else if(dayNumber == 7)
                 	{
                 		dayName = "Saturday";
                 	}
                 	slots = faculty_availability[faculty == facultyId && day == dayName && status == "Available"];
                 	for each  slot in slots
                 	{
                 		if(reqTime >= slot.start_time && reqTime < slot.end_time)
                 		{
                 			result.put("available",true);
                 			result.put("message","Faculty is available.");
                 			result.put("mode",ifNull(slot.mode,""));
                 			result.put("location",ifNull(slot.location_meeting_link,""));
                 			result.put("max_appointments",ifNull(slot.max_appointments,0));
                 			// IMPORTANT: Keep these as TIME values
                 			result.put("slot_start",slot.start_time);
                 			result.put("slot_end",slot.end_time);
                 			break;
                 		}
                 	}
                 	if(result.get("available") != true)
                 	{
                 		result.put("message","No available faculty slot found for the selected date and time.");
                 	}
                 	return result;
                 }
				 int get_mentor_from_department(int deptId)
                 {
                 	dept = department_master[ID == deptId];
                 	if(dept.count() == 0)
                 	{
                 		return 0;
                 	}
                 	coordinator = dept.department_coordinator;
                 	if(coordinator == null)
                 	{
                 		return 0;
                 	}
                 	firstName = coordinator.first_name;
                 	lastName = coordinator.last_name;
                 	facultyRec = faculty_master[faculty_name.first_name == firstName && faculty_name.last_name == lastName && status == "Active"];
                 	if(facultyRec.count() > 0)
                 	{
                 		return facultyRec.ID;
                 	}
                 	return 0;
                 }
				 bool is_active_faculty(int facultyId)
                 {
                 	facultyRec = faculty_master[ID == facultyId && status == "Active"];
                 	if(facultyRec.count() > 0)
                 	{
                 		return true;
                 	}
                 	return false;
                 }
				 bool is_active_student(int studentId)
                 {
                 	studentRec = student_registration[ID == studentId && status == "Active"];
                 	if(studentRec.count() > 0)
                 	{
                 		return true;
                 	}
                 	return false;
                 }
				 void send_tomorrow_reminders()
                 {
                 	tomorrow = zoho.currentdate.addDay(1);
                 	appointments = appointment[appointment_date == tomorrow && status == "Scheduled"];
                 	for each  appt in appointments
                 	{
                 		if(appt.consultation_request == null)
                 		{
                 			continue;
                 		}
                 		requestRec = consultation_request[ID == appt.consultation_request.ID];
                 		if(requestRec.count() == 0)
                 		{
                 			continue;
                 		}
                 		studentRec = student_registration[ID == requestRec.student.ID];
                 		facultyRec = faculty_master[ID == requestRec.faculty.ID];
                 		dateText = appt.appointment_date.toString("dd-MMM-yyyy");
                 		timeText = appt.start_time.toString("HH:mm") + " - " + appt.end_time.toString("HH:mm");
                 		modeText = ifNull(appt.mode,"Not specified");
                 		locationText = ifNull(appt.location_meeting_link,"Not specified");
                 		if(studentRec.count() > 0 && studentRec.email != null)
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :studentRec.email
                 				subject :"MentorConnect - Consultation Reminder"
                 				message :"Hello " + studentRec.student_name.first_name + ",<br><br>" + "This is a reminder that you have a faculty consultation tomorrow.<br><br>" + "<b>Date:</b> " + dateText + "<br>" + "<b>Time:</b> " + timeText + "<br>" + "<b>Mode:</b> " + modeText + "<br>" + "<b>Location / Meeting Link:</b> " + locationText + "<br><br>Please attend on time.<br><br>" + "MentorConnect"
                 			]
                 		}
                 		if(facultyRec.count() > 0 && facultyRec.email != null)
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :facultyRec.email
                 				subject :"MentorConnect - Faculty Reminder"
                 				message :"Hello " + facultyRec.faculty_name.first_name + ",<br><br>" + "You have a consultation scheduled for tomorrow.<br><br>" + "<b>Date:</b> " + dateText + "<br>" + "<b>Time:</b> " + timeText + "<br>" + "<b>Mode:</b> " + modeText + "<br><br>MentorConnect"
                 			]
                 		}
                 		appt.status="Reminder Sent";
                 	}
                 }
				 void sync_request_from_appointment(int appointmentId, string appointmentStatus)
                 {
                 	appt = appointment[ID == appointmentId];
                 	if(appt.count() == 0)
                 	{
                 		return;
                 	}
                 	if(appt.consultation_request == null)
                 	{
                 		return;
                 	}
                 	requestRec = consultation_request[ID == appt.consultation_request.ID];
                 	if(requestRec.count() == 0)
                 	{
                 		return;
                 	}
                 	newStatus = "";
                 	if(appointmentStatus == "Completed")
                 	{
                 		newStatus = "Completed";
                 	}
                 	else if(appointmentStatus == "Cancelled")
                 	{
                 		newStatus = "Cancelled";
                 	}
                 	else if(appointmentStatus == "Rescheduled")
                 	{
                 		newStatus = "Reschedule Requested";
                 	}
                 	if(newStatus != "")
                 	{
                 		requestRec.status=newStatus;
                 	}
                 }
				 map validate_appointment_slot(int facultyId, date apptDate, time apptTime)
                 {
                 	result = Map();
                 	result.put("allowed",false);
                 	result.put("message","");
                 	if(facultyId == null)
                 	{
                 		result.put("message","Faculty is required.");
                 		return result;
                 	}
                 	if(apptDate == null)
                 	{
                 		result.put("message","Appointment date is required.");
                 		return result;
                 	}
                 	if(apptTime == null)
                 	{
                 		result.put("message","Appointment time is required.");
                 		return result;
                 	}
                 	slotInfo = thisapp.get_faculty_slot(facultyId,apptDate,apptTime);
                 	if(slotInfo.get("available") != true)
                 	{
                 		result.put("message","Faculty is not available at the selected date and time.");
                 		return result;
                 	}
                 	slotStart = slotInfo.get("slot_start");
                 	slotEnd = slotInfo.get("slot_end");
                 	appointments = appointment[faculty == facultyId && appointment_date == apptDate];
                 	conflictFound = false;
                 	activeCount = 0;
                 	for each  appt in appointments
                 	{
                 		if(appt.status != "Cancelled" && appt.status != "Rescheduled")
                 		{
                 			// Compare actual TIME values
                 			if(apptTime >= appt.start_time && apptTime < appt.end_time)
                 			{
                 				conflictFound = true;
                 			}
                 			// Count appointments inside this availability slot
                 			if(appt.start_time >= slotStart && appt.start_time < slotEnd)
                 			{
                 				activeCount = activeCount + 1;
                 			}
                 		}
                 	}
                 	if(conflictFound)
                 	{
                 		result.put("message","The selected faculty already has an appointment at this time.");
                 		return result;
                 	}
                 	maxAppointments = slotInfo.get("max_appointments");
                 	if(maxAppointments > 0 && activeCount >= maxAppointments)
                 	{
                 		result.put("message","The faculty availability slot has reached its maximum appointment capacity.");
                 		return result;
                 	}
                 	result.put("allowed",true);
                 	result.put("message","Appointment slot is available.");
                 	return result;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Auto_Assign_Mentor_on_Dep as "Auto Assign Mentor on Department Selection"
			{
				type =  form
				form = student_registration

				record event = on add

				on user input of department
				{
					actions 
					{
						custom deluge script
						(
											if(input.department != null)
										{
											mentorId = thisapp.get_mentor_from_department(input.department.ID);
											if(mentorId > 0)
											{
												input.mentor = mentorId;
											}
											else
											{
												alert "No active faculty mentor is mapped to this department.";
											}
										}
						)
					}
				}

			}
			Validate_Consultation_Req as "Validate Consultation Request Booking"
			{
				type =  form
				form = consultation_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.student == null)
										{
											alert "Please select a student.";
											cancel submit;
										}
										if(input.faculty == null)
										{
											alert "Please select a faculty member.";
											cancel submit;
										}
										if(input.preferred_date == null)
										{
											alert "Please select a preferred consultation date.";
											cancel submit;
										}
										if(input.preferred_time_slot == null)
										{
											alert "Please select a preferred consultation time.";
											cancel submit;
										}
										if(input.preferred_date < zoho.currentdate)
										{
											alert "Consultation date cannot be in the past.";
											cancel submit;
										}
										studentActive = thisapp.is_active_student(input.student.ID);
										if(studentActive != true)
										{
											alert "Only active students can create consultation requests.";
											cancel submit;
										}
										facultyActive = thisapp.is_active_faculty(input.faculty.ID);
										if(facultyActive != true)
										{
											alert "The selected faculty member is not active.";
											cancel submit;
										}
										slotResult = thisapp.validate_appointment_slot(input.faculty.ID,input.preferred_date,input.preferred_time_slot);
										if(slotResult.get("allowed") != true)
										{
											alert slotResult.get("message");
											cancel submit;
										}
										input.status = "Submitted";
						)
					}
				}

			}
			Send_Appointment_Confirma as "Send Appointment Confirmation"
			{
				type =  form
				form = appointment

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.confirm_appointment(input.ID);
						)
					}
				}

			}
			Synchronize_Consultation_ as "Synchronize Consultation Request Status"
			{
				type =  form
				form = appointment

				record event = on edit

				on update of status
				{
					actions 
					{
						custom deluge script
						(
											thisapp.sync_request_from_appointment(input.ID,input.status);
						)
					}
				}

			}
			Notify_Students_Faculty_Available as "Notify Students on Faculty Availability"
			{
				type =  form
				form = faculty_availability

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the faculty record from the input availability record
										facultyRecord = faculty_master[ID == input.faculty];
										// Check if faculty record exists and is active
										if(facultyRecord != null && facultyRecord.status == "Active")
										{
											// Get faculty name components
											facultyFirstName = facultyRecord.faculty_name.first_name;
											facultyLastName = facultyRecord.faculty_name.last_name;
											facultyName = facultyFirstName + " " + facultyLastName;
											// Get faculty email
											facultyEmail = facultyRecord.email;
											// Fetch pending consultation requests that match this faculty
											// Status options: Submitted, Reschedule Requested, Completed, Confirmed, Cancelled
											pendingRequests = consultation_request[faculty == input.faculty && status == "Submitted" || status == "Reschedule Requested"];
											// Check if there are any pending requests
											if(pendingRequests.count() > 0)
											{
												// Iterate through each pending request to send notifications
												for each  request in pendingRequests
												{
													// Get student record from the request
													studentRecord = student_registration[ID == request.student];
													if(studentRecord != null && studentRecord.status == "Active")
													{
														// Get student name components
														studentFirstName = studentRecord.student_name.first_name;
														studentLastName = studentRecord.student_name.last_name;
														studentName = studentFirstName + " " + studentLastName;
														// Get student email
														studentEmail = studentRecord.email;
														// Prepare email content
														emailSubject = "Faculty Availability Update: " + facultyName + " is now available";
														emailMessage = "<p>Dear " + studentName + ",</p>";
														emailMessage = emailMessage + "<p>We are pleased to inform you that your mentor, " + facultyName + ", is now available for consultation.</p>";
														emailMessage = emailMessage + "<p>Your consultation request (ID: " + request.request_id + ") regarding " + request.concern_category + " has been noted.</p>";
														emailMessage = emailMessage + "<p>Please log in to the portal to schedule an appointment at your convenience.</p>";
														emailMessage = emailMessage + "<p>Best regards,<br/>Mentor Connect Team</p>";
														// Send email notification to student
														sendmail
														[
															from :zoho.adminuserid
															to :studentEmail
															subject :emailSubject
															message :emailMessage
															content type :HTML
														]
													}
												}
											}
											else
											{
												// No pending requests for this faculty
												info "No pending consultation requests found for faculty: " + facultyName;
											}
										}
										else
										{
											// Faculty record not found or inactive
											info "Faculty record not found or inactive";
										}
						)
					}
				}

			}
			Notify_Student_Available_Slot as "Notify Student on Available Slot"
			{
				type =  form
				form = consultation_request

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the student record using the multi-select lookup ID
										studentList = student_registration[ID == input.student];
										if(studentList.count() > 0)
										{
											// Access the first (and typically only) student record
											studentRecord = studentList;
											// Get student email from the record
											studentEmail = studentRecord.email;
											// Get student name from composite field
											studentName = studentRecord.student_name.first_name;
											// Get faculty name from multi-select lookup
											facultyList = faculty_master[ID == input.faculty];
											facultyName = "";
											if(facultyList.count() > 0)
											{
												facultyRecord = facultyList;
												facultyName = facultyRecord.faculty_name.first_name;
											}
											// Get consultation details
											concernCategory = input.concern_category;
											preferredDate = input.preferred_date;
											preferredTime = input.preferred_time_slot;
											concernDesc = input.concern_description;
											// Construct email subject and message
											emailSubject = "Consultation Request Submitted - " + concernCategory;
											emailMessage = "<p>Dear " + studentName + ",</p>";
											emailMessage = emailMessage + "<p>Your consultation request has been successfully submitted.</p>";
											emailMessage = emailMessage + "<p><strong>Details:</strong></p>";
											emailMessage = emailMessage + "<ul>";
											emailMessage = emailMessage + "<li>Category: " + concernCategory + "</li>";
											if(preferredDate != null)
											{
												emailMessage = emailMessage + "<li>Preferred Date: " + preferredDate + "</li>";
											}
											if(preferredTime != null)
											{
												// Convert time to string to avoid arithmetic operations on TIME values
												timeStr = preferredTime.toString();
												emailMessage = emailMessage + "<li>Preferred Time: " + timeStr + "</li>";
											}
											if(facultyName != "")
											{
												emailMessage = emailMessage + "<li>Requested Faculty: " + facultyName + "</li>";
											}
											emailMessage = emailMessage + "</ul>";
											emailMessage = emailMessage + "<p>If a faculty slot is available, you will receive a confirmation shortly.</p>";
											emailMessage = emailMessage + "<p>Best regards,<br>Faculty Consultation System</p>";
											// Send email notification
											sendmail
											[
												from :zoho.adminuserid
												to :studentEmail
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
										else
										{
											info "Student record not found for the provided student ID";
										}
						)
					}
				}

			}
			Notify_Faculty_New_Appointment as "Notify Faculty of New Appointment"
			{
				type =  form
				form = appointment

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch faculty records based on the multi-select lookup IDs
										facultyList = faculty_master[ID in input.faculty.ID.getall()];
										// Prepare the email message content
										emailBody = "<p>Dear Faculty,</p>";
										emailBody = emailBody + "<p>A new appointment has been scheduled with the following details:</p>";
										emailBody = emailBody + "<ul>";
										// Loop through each faculty member to construct the message
										for each  faculty in facultyList
										{
											facultyName = input.faculty.faculty_name.first_name + " " + input.faculty.faculty_name.last_name;
											emailBody = emailBody + "<li><strong>Faculty:</strong> " + facultyName + "</li>";
										}
										// Add student details
										studentName = input.student.student_name.first_name + " " + input.student.student_name.last_name;
										emailBody = emailBody + "<li><strong>Student Name:</strong> " + studentName + "</li>";
										emailBody = emailBody + "<li><strong>Student Email:</strong> " + input.student.email + "</li>";
										emailBody = emailBody + "<li><strong>Student Mobile:</strong> " + input.student.mobile_number + "</li>";
										// Add appointment details
										emailBody = emailBody + "<li><strong>Appointment Date:</strong> " + input.appointment_date + "</li>";
										emailBody = emailBody + "<li><strong>Start Time:</strong> " + input.start_time.toString() + "</li>";
										emailBody = emailBody + "<li><strong>End Time:</strong> " + input.end_time.toString() + "</li>";
										emailBody = emailBody + "<li><strong>Mode:</strong> " + input.mode + "</li>";
										if(input.location_meeting_link != null && input.location_meeting_link != "")
										{
											emailBody = emailBody + "<li><strong>Meeting Link:</strong> <a href='" + input.location_meeting_link + "'>Click Here</a></li>";
										}
										else
										{
											emailBody = emailBody + "<li><strong>Location:</strong> Offline (No link provided)</li>";
										}
										emailBody = emailBody + "</ul>";
										emailBody = emailBody + "<p>Please prepare accordingly.</p>";
										// Send email to all faculty members
										for each  faculty in facultyList
										{
											sendmail
											[
												from :zoho.adminuserid
												to :input.faculty.email
												subject :"New Appointment Scheduled - " + studentName
												message :emailBody
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

