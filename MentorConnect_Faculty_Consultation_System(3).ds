	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_notification_sent
			(
    			type = checkbox
				displayname = "Availability Notification Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Request Submitted","Pending Faculty Assignment","Request Cancelled","Faculty Assigned","In Progress","Under Review","Completed","Closed"}
			}
		}
